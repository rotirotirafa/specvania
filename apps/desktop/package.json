{
  "name": "specvania-desktop",
  "version": "0.1.0",
  "description": "The optional desktop window for the specvania web app",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --test ../../tests/desktop/*.test.cjs",
    "make-icon": "node scripts/make-icon.mjs",
    "dist:mac": "npm run make-icon && electron-builder --mac --publish never",
    "dist:linux": "npm run make-icon && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
